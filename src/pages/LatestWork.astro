        <!-- Modal -->
        <div id="videoModal" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <iframe
                    id="modalVideo"
                    class="vimeoVideo"
                    style="width: 100%; height: 100%; border: none;"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen></iframe>
            </div>
        </div>

        <script>
            declare var Vimeo: any; // Esto le dice a TypeScript que Vimeo puede ser cualquier cosa

            document.addEventListener("DOMContentLoaded", function () {
                var tag = document.createElement("script");
                tag.src = "https://player.vimeo.com/api/player.js";
                document.body.appendChild(tag);

                tag.onload = function () {
                    const projects =
                        document.querySelectorAll<HTMLElement>(".project");
                    const modal = document.getElementById("videoModal");
                    const modalVideo = document.getElementById(
                        "modalVideo",
                    ) as HTMLIFrameElement;
                    const closeModal = document.querySelector(".close");

                    if (modal && modalVideo && closeModal) {
                        projects.forEach((project) => {
                            const iframe =
                                project.querySelector<HTMLIFrameElement>(
                                    "iframe",
                                );
                            const title =
                                project.querySelector<HTMLElement>(
                                    ".videoTitle",
                                );
                            const overlay =
                                project.querySelector<HTMLElement>(
                                    ".clickable-overlay",
                                );

                            if (iframe && title && overlay) {
                                const player = new Vimeo.Player(iframe);

                                project.addEventListener(
                                    "mouseenter",
                                    function () {
                                        player.play().catch((error: Error) => {
                                            console.error(
                                                "Error al iniciar la reproducción:",
                                                error.message,
                                            );
                                        });
                                        title.style.opacity = "1"; // Hace el título completamente visible
                                    },
                                );

                                project.addEventListener(
                                    "mouseleave",
                                    function () {
                                        player.pause().catch((error: Error) => {
                                            console.error(
                                                "Error al pausar la reproducción:",
                                                error.message,
                                            );
                                        });
                                        title.style.opacity = "0"; // Hace el título completamente invisible de nuevo
                                    },
                                );

                                overlay.addEventListener("click", function () {
                                    const url =
                                        project.getAttribute("data-url");
                                    if (url) {
                                        modal.style.display = "flex";
                                        const videoSrc =
                                            url.replace(
                                                "vimeo.com/",
                                                "player.vimeo.com/video/",
                                            ) + "?autoplay=1&loop=0&muted=0";
                                        modalVideo.setAttribute(
                                            "src",
                                            videoSrc,
                                        );
                                    }
                                });
                            }
                        });

                        closeModal.addEventListener("click", function () {
                            modal.style.display = "none";
                            modalVideo.setAttribute("src", ""); // Detener el video al cerrar el modal
                        });

                        window.addEventListener("click", function (event) {
                            if (event.target === modal) {
                                modal.style.display = "none";
                                modalVideo.setAttribute("src", ""); // Detener el video al cerrar el modal
                            }
                        });
                    }
                };
            });
        </script>

        <style>
            body {
                margin: 0;
                padding: 0;
                background-color: #000; /* Fondo negro */
                color: #fff;
                font-family: Helvetica, Arial, sans-serif; /* Fuente Helvética */
            }

            .wrapper {
                display: flex;
                justify-content: center;
                align-items: center;
                flex-direction: column;
                margin-top: 150px; /* Espacio para el menú */
                padding: 20px; /* Espaciado alrededor del contenedor */
                width: 100%;
            }

            .grid-container {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 20px; /* Espacio entre elementos */
                width: 100%;
                max-width: 1200px; /* Limita el ancho máximo para centrar mejor el contenido */
            }

            .project {
                overflow: hidden; /* Oculta cualquier contenido que se desborde del contenedor */
                position: relative; /* Posicionamiento relativo para los hijos absolutos */
                flex: 1 1 300px; /* Permite que los elementos crezcan y se encojan */
                max-width: 300px; /* Ancho máximo para los proyectos */
                height: 200px; /* Altura fija para los proyectos */
                background-size: cover;
                background-position: center;
                transition: transform 0.3s ease; /* Transición suave para el efecto de hover */
                background-color: #111; /* Fondo para un aspecto minimalista */
                border-radius: 10px; /* Bordes redondeados para un estilo más suave */
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); /* Sombra para darle profundidad */
                border: 1px solid rgba(255, 255, 255, 0.1); /* Borde sutil */
                cursor: pointer; /* Cursor pointer para indicar que se puede hacer clic */
            }

            .project iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none; /* Evita que el iframe capture eventos de ratón */
            }

            .clickable-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: transparent; /* Fondo transparente */
                cursor: pointer;
            }

            .project:hover {
                transform: scale(1.05); /* Efecto de zoom al pasar el cursor */
            }

            .videoTitle {
                display: block;
                opacity: 0;
                position: absolute;
                bottom: 10px;
                left: 10px;
                color: white;
                transition: opacity 0.5s ease; /* Transición suave de la opacidad */
                font-size: 16px;
                background: rgba(0, 0, 0, 0.5); /* Fondo semi-transparente */
                padding: 5px 10px;
                border-radius: 5px;
            }

            /* Media queries para ajustar la grilla en pantallas más pequeñas */
            @media (max-width: 800px) {
                .grid-container {
                    flex-direction: column; /* Colocar los videos uno debajo del otro */
                    align-items: center;
                }

                .project {
                    width: 90%; /* Ajustar el tamaño de los videos */
                    height: 250px; /* Aumentar la altura de los videos */
                }
            }

            @media (max-width: 600px) {
                .project {
                    width: 100%; /* Ajuste de ancho para móviles */
                    height: 300px; /* Aumentar la altura para móviles */
                }
            }

            .modal {
                display: none; /* Oculta el modal por defecto */
                position: fixed;
                z-index: 1000;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(
                    0,
                    0,
                    0,
                    0.9
                ); /* Fondo semi-transparente */
                justify-content: center;
                align-items: center;
            }

            .modal-content {
                background-color: #000;
                margin: auto;
                padding: 20px;
                border: 1px solid #888;
                width: 80%;
                max-width: 800px; /* Ancho máximo del modal */
                height: 450px; /* Altura fija del modal */
                border-radius: 10px; /* Bordes redondeados para el modal */
                position: relative; /* Necesario para el botón de cierre */
            }

            .close {
                color: #aaa;
                position: absolute; /* Posición absoluta dentro del modal */
                top: 10px;
                right: 10px;
                font-size: 28px;
                font-weight: bold;
            }

            .close:hover,
            .close:focus {
                color: white;
                text-decoration: none;
                cursor: pointer;
            }
        </style>
    </body>
</html>
