---
import Menu from "../components/Menu.astro";
import videos from "../data/videos.json";

const videosOrdenados = videos.sort((a, b) => a.pos - b.pos);
---

<html lang="es">
    <head>
        <title>Latest Work</title>
    </head>
    <body>
        <Menu />
        <div class="wrapper">
            <div class="grid-container">
                {
                    videosOrdenados.map((video) => (
                        <div
                            class="project"
                            data-url={`https://vimeo.com/${video.id}`}
                        >
                            <div class="clickable-overlay" />
                            <iframe
                                class="vimeoVideo"
                                src={`https://player.vimeo.com/video/${video.id}?autoplay=0&loop=1&muted=1&background=1#t=20s`}
                                style="width: 100%; height: 100%; border: none; pointer-events: none;"
                                allow="autoplay; fullscreen; picture-in-picture"
                                allowfullscreen
                            />
                            <div class="videoTitle">{video.titulo}</div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Modal -->
        <div id="videoModal" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <iframe
                    id="modalVideo"
                    class="vimeoVideo"
                    style="width: 100%; height: 100%; border: none;"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen></iframe>
            </div>
        </div>

        <script>
            declare var Vimeo: any;

            document.addEventListener("DOMContentLoaded", function () {
                var tag = document.createElement("script");
                tag.src = "https://player.vimeo.com/api/player.js";
                document.body.appendChild(tag);

                tag.onload = function () {
                    const projects =
                        document.querySelectorAll<HTMLElement>(".project");
                    const modal = document.getElementById("videoModal");
                    const modalVideo = document.getElementById(
                        "modalVideo",
                    ) as HTMLIFrameElement;
                    const closeModal = document.querySelector(".close");

                    if (modal && modalVideo && closeModal) {
                        projects.forEach((project) => {
                            const iframe =
                                project.querySelector<HTMLIFrameElement>(
                                    "iframe",
                                );
                            const title =
                                project.querySelector<HTMLElement>(
                                    ".videoTitle",
                                );
                            const overlay =
                                project.querySelector<HTMLElement>(
                                    ".clickable-overlay",
                                );

                            if (iframe && title && overlay) {
                                const player = new Vimeo.Player(iframe);

                                project.addEventListener(
                                    "mouseenter",
                                    function () {
                                        player.play().catch((error: Error) => {
                                            console.error(
                                                "Error al iniciar la reproducción:",
                                                error.message,
                                            );
                                        });
                                        title.style.opacity = "1";
                                    },
                                );

                                project.addEventListener(
                                    "mouseleave",
                                    function () {
                                        player.pause().catch((error: Error) => {
                                            console.error(
                                                "Error al pausar la reproducción:",
                                                error.message,
                                            );
                                        });
                                        title.style.opacity = "0";
                                    },
                                );

                                overlay.addEventListener("click", function () {
                                    const url =
                                        project.getAttribute("data-url");
                                    if (url) {
                                        modal.style.display = "flex";
                                        const videoSrc =
                                            url.replace(
                                                "vimeo.com/",
                                                "player.vimeo.com/video/",
                                            ) + "?autoplay=1&loop=0&muted=0";
                                        modalVideo.setAttribute(
                                            "src",
                                            videoSrc,
                                        );
                                    }
                                });
                            }
                        });

                        closeModal.addEventListener("click", function () {
                            modal.style.display = "none";
                            modalVideo.setAttribute("src", "");
                        });

                        window.addEventListener("click", function (event) {
                            if (event.target === modal) {
                                modal.style.display = "none";
                                modalVideo.setAttribute("src", "");
                            }
                        });
                    }
                };
            });
        </script>

        <style>
            body {
                margin: 0;
                padding: 0;
                background-color: #000;
                color: #fff;
                font-family: Helvetica, Arial, sans-serif;
            }

            .wrapper {
                display: flex;
                justify-content: center;
                align-items: center;
                flex-direction: column;
                margin-top: 150px;
                padding: 20px;
                width: 100%;
            }

            .grid-container {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 20px;
                width: 100%;
                max-width: 1200px;
            }

            .project {
                overflow: hidden;
                position: relative;
                flex: 1 1 300px;
                max-width: 300px;
                height: 200px;
                background-size: cover;
                background-position: center;
                transition: transform 0.3s ease;
                background-color: #111;
                border-radius: 10px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.1);
                cursor: pointer;
            }

            .project iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
            }

            .clickable-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: transparent;
                cursor: pointer;
            }

            .project:hover {
                transform: scale(1.05);
            }

            .videoTitle {
                display: block;
                opacity: 0;
                position: absolute;
                bottom: 10px;
                left: 10px;
                color: white;
                transition: opacity 0.5s ease;
                font-size: 16px;
                background: rgba(0, 0, 0, 0.5);
                padding: 5px 10px;
                border-radius: 5px;
            }

            @media (max-width: 800px) {
                .grid-container {
                    flex-direction: column;
                    align-items: center;
                }
                .project {
                    width: 90%;
                    height: 250px;
                }
            }

            @media (max-width: 600px) {
                .project {
                    width: 100%;
                    height: 300px;
                }
            }

            .modal {
                display: none;
                position: fixed;
                z-index: 1000;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.9);
                justify-content: center;
                align-items: center;
            }

            .modal-content {
                background-color: #000;
                margin: auto;
                padding: 20px;
                border: 1px solid #888;
                width: 80%;
                max-width: 800px;
                height: 450px;
                border-radius: 10px;
                position: relative;
            }

            .close {
                color: #aaa;
                position: absolute;
                top: 10px;
                right: 10px;
                font-size: 28px;
                font-weight: bold;
            }

            .close:hover,
            .close:focus {
                color: white;
                text-decoration: none;
                cursor: pointer;
            }
        </style>
    </body>
</html>
