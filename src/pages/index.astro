---
// Importa los componentes necesarios
import Layout from "../layouts/Layout.astro";
import Loader from "../components/Loader.astro";
import Menu from "../components/Menu.astro";
import VideoControl, { videoList } from "../components/VideoControl.astro";
---

<Layout title="| David Moreno |">
    <Loader />
    <Menu />
    <main>
        {
            videoList.length > 0 ? (
                <div class="video-container">
                    <video
                        id="carousel-video"
                        autoplay
                        loop
                        muted
                        playsinline
                        preload="auto"
                    >
                        <source src={videoList[0].src} type="video/mp4" />
                        Tu navegador no soporta videos HTML5.
                    </video>
                    <div id="video-title" class="video-title">
                        {videoList[0].title}
                    </div>
                </div>
            ) : (
                <div class="no-videos">No hay videos disponibles.</div>
            )
        }
    </main>
    <VideoControl />
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const videoElement = document.getElementById(
            "carousel-video",
        ) as HTMLVideoElement;
        const titleElement = document.getElementById(
            "video-title",
        ) as HTMLElement;

        const hideTitle = () => {
            if (titleElement) {
                titleElement.style.opacity = "0";
            }
        };

        const showTitle = (title: string) => {
            if (titleElement) {
                titleElement.textContent = title ?? "";
                titleElement.style.opacity = "1";
                setTimeout(hideTitle, 5000);
            }
        };

        const controls = Array.from(
            document.querySelectorAll(".slider-control"),
        ) as HTMLElement[];
        const videoSources = controls.map((control) => ({
            src: control.getAttribute("data-video") as string,
            title: control.getAttribute("data-title") as string,
        }));

        let currentIndex = 0;

        const changeVideo = ({
            src,
            title,
        }: {
            src: string;
            title: string;
        }) => {
            if (videoElement instanceof HTMLVideoElement) {
                videoElement.pause();
                // Limpiamos el src actual para liberar ancho de banda antes de cargar el siguiente
                videoElement.removeAttribute("src");
                videoElement.load();

                videoElement.src = src;
                videoElement.load();
                videoElement.play();
                showTitle(title);
            }
        };

        const changeDots = () => {
            controls.forEach((control, index) => {
                control.style.borderRadius = `${Math.random() * 50}%`;
                control.style.transform = `scale(${Math.random() * 0.5 + 1})`;
                control.style.borderColor =
                    index === currentIndex ? "red" : "white";
            });
        };

        controls.forEach((control, index) => {
            control.addEventListener("click", (e) => {
                e.preventDefault();
                controls.forEach((ctrl) => ctrl.classList.remove("active"));
                control.classList.add("active");
                currentIndex = index;
                changeVideo(videoSources[index]);
                changeDots();
            });
        });

        setInterval(() => {
            currentIndex = (currentIndex + 1) % videoSources.length;
            controls.forEach((ctrl) => ctrl.classList.remove("active"));
            if (controls[currentIndex])
                controls[currentIndex].classList.add("active");
            changeVideo(videoSources[currentIndex]);
            changeDots();
        }, 10000);

        // Se eliminó la función lazyLoadVideo por ser redundante en videos fixed
    });
</script>

<style>
    body {
        margin: 0;
        padding: 0;
        background: #0f0f0f;
        font-family: Helvetica, Arial, sans-serif;
    }
    main {
        position: relative;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1;
    }
    .video-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow: hidden;
        z-index: -1;
        background-color: black;
    }
    .video-container video {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        min-width: 100vw;
        min-height: 100vh;
        width: auto;
        height: auto;
        object-fit: cover;
    }
    .video-title {
        position: fixed;
        top: 50%;
        right: 2%;
        color: #fff;
        font-size: 1.5vw;
        z-index: 2;
        pointer-events: none;
        text-align: right;
        opacity: 0;
        transition: opacity 1s ease;
    }
    .no-videos {
        color: white;
        font-size: 1.5vw;
    }

    @media (max-width: 768px) {
        .video-container video {
            width: 100vw;
            height: 100vh;
        }
        .video-title {
            font-size: 5vw;
            top: 85%;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            width: 90%;
        }
    }
</style>
