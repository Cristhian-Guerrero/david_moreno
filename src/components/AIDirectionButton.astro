<a
    href="https://davidmod321.myportfolio.com/"
    target="_blank"
    data-astro-reload
    class="menu-item menu-item-ai1"></a>

<style>
    .menu-item {
        display: block;
        width: 230px;
        height: 50px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        transition:
            background-image 0.7s ease,
            transform 0.7s ease;
    }

    .menu-item-ai1 {
        background-image: url("/images/btn/AIDIRECTION1.png");
        margin: 0 10px;
    }

    .menu-item-ai1:hover {
        background-image: url("/images/btn/AIDIRECTION2.png");
        transform: scale(1.1);
    }

    .menu-item-ai1:active {
        background-image: url("/images/btn/AIDIRECTION3.png");
        transform: scale(1.2);
    }

    .menu-item-ai1:focus {
        background-image: url("/images/btn/AIDIRECTION3.png");
        transform: scale(1.1);
    }

    @media (max-width: 768px) {
        .menu-item {
            width: 200px;
            height: 40px;
            margin: 0;
        }
    }

    @media (max-width: 480px) {
        .menu-item {
            width: 130px;
            height: 30px;
            margin: 0;
        }
    }
</style>
