---
export const videoList = [
    {
        src: "/videos/SEDAL.mp4",
        title: "RBD SEDAL",
    },
    {
        src: "/videos/ali.mp4",
        title: "ALI A.K.A. MIND - So Sad",
    },
    {
        src: "/videos/KFC.mp4",
        title: "KFC - IT'S NICE",
    },
    {
        src: "/videos/OCEANBANK.mp4",
        title: "OCEAN BANK - We'll take your further",
    },
];
---

<nav class="slider-controls">
    {
        videoList.map((video, index) => (
            <div
                class:list={["slider-control", index === 0 ? "active" : ""]}
                data-video={video.src}
                data-title={video.title}
            />
        ))
    }
</nav>

<style>
    .slider-controls {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        position: fixed;
        bottom: 2%;
        right: 2%;
        gap: 12px;
        z-index: 100;
    }

    .slider-control {
        width: 10px;
        height: 10px;
        background-color: rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        transition: all 0.4s ease;
        cursor: pointer;
        flex-shrink: 0;
    }

    .slider-control:hover {
        background-color: rgba(255, 255, 255, 0.8);
        transform: scale(1.2);
    }

    .slider-control.active {
        background-color: rgba(255, 255, 255, 1);
        transform: scale(1.4);
    }
</style>
