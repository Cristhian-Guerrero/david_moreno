---
// LatestWorkButton.astro
---

<a href="/LatestWork" class="menu-item menu-item-latest1"></a>

<style>
    .menu-item {
        display: block;
        width: 300px;
        height: 50px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        transition:
            background-image 0.7s ease,
            transform 0.7s ease;
    }

    .menu-item-latest1 {
        background-image: url("/images/btn/LATEST1.png");
        margin-left: 10px; /* Ajuste para organizar los botones */
    }

    .menu-item-latest1:hover {
        background-image: url("/images/btn/LATEST2.png");
        transform: scale(1.1);
    }

    .menu-item-latest1:active {
        background-image: url("/images/btn/LATEST3.png");
        transform: scale(1.2);
    }

    .menu-item-latest1:focus {
        background-image: url("/images/btn/LATEST4.png");
        transform: scale(1.1);
    }

    @media (max-width: 768px) {
        .menu-item {
            width: 250px;
            height: 40px;
            margin-left: 0; /* Quitar margen en modo responsive */
        }
    }

    @media (max-width: 480px) {
        .menu-item {
            width: 150px;
            height: 30px;
            margin-left: 0; /* Quitar margen en modo responsive */
        }
    }
</style>
